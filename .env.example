# Supabase (обязательно)
# .env в этом репозитории использует NEXT_PUBLIC_*; Vite тоже читает VITE_*.
VITE_SUPABASE_PROJECT_ID="mebomnqdtuqmjjefvgkx"
VITE_SUPABASE_URL="https://mebomnqdtuqmjjefvgkx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Алиасы (как в текущем .env)
# NEXT_PUBLIC_SUPABASE_URL=https://mebomnqdtuqmjjefvgkx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Demo seed script (scripts/seed-demo.ts) — service role only, never expose in client
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Demo login with chats, buyers and announcements (scripts/seed-demo-inbox.ts); the login code arrives here
# DEMO_INBOX_EMAIL=you+demo@example.com

# Firebase Push (опционально)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
